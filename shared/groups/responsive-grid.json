{
  "id": "responsiveGrid",
  "name": {
    "en": "Responsive grid",
    "zh-CN": "响应式栅格"
  },
  "elements": [
    {
      "type": "select",
      "field": "desktopColumns",
      "default": 4,
      "name": {
        "en": "Desktop columns",
        "zh-CN": "桌面端列数"
      },
      "cssVariable": "--section-desktop-columns",
      "options": [
        { "value": 1, "name": { "en": "1 column", "zh-CN": "1 列" } },
        { "value": 2, "name": { "en": "2 columns", "zh-CN": "2 列" } },
        { "value": 3, "name": { "en": "3 columns", "zh-CN": "3 列" } },
        { "value": 4, "name": { "en": "4 columns", "zh-CN": "4 列" } },
        { "value": 6, "name": { "en": "6 columns", "zh-CN": "6 列" } }
      ]
    },
    {
      "type": "select",
      "field": "mobileColumns",
      "default": 2,
      "name": {
        "en": "Mobile columns",
        "zh-CN": "移动端列数"
      },
      "cssVariable": "--section-mobile-columns",
      "options": [
        { "value": 1, "name": { "en": "1 column", "zh-CN": "1 列" } },
        { "value": 2, "name": { "en": "2 columns", "zh-CN": "2 列" } }
      ]
    }
  ]
}

