{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oga.example/contracts/theme.product-card.v1.json",
  "title": "Theme Product Card Data v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["productList", "currency"],
  "properties": {
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "symbol"],
      "properties": {
        "code": { "type": "string", "minLength": 3, "maxLength": 3 },
        "symbol": { "type": "string", "minLength": 1 }
      }
    },
    "productList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "subtitle",
          "coverImage",
          "seoUrl",
          "minPrice",
          "saleMode"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "coverImage": { "type": "string" },
          "seoUrl": { "type": "string" },
          "minPrice": { "type": "number", "minimum": 0 },
          "saleMode": { "enum": ["INQUIRY", "CHECKOUT", "BOTH"] }
        }
      }
    }
  }
}
